{
  "name": "orchestrator-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "dev": "vite",
    "build": "bun scripts/tokens.mjs --check && vite build",
    "tokens": "bun scripts/tokens.mjs",
    "tokens:check": "bun scripts/tokens.mjs --check",
    "test": "vitest run",
    "tauri": "TAURI_APP_PATH=../crates/orch-app TAURI_FRONTEND_PATH=. tauri",
    "check": "svelte-check --tsconfig ./jsconfig.json --fail-on-warnings",
    "lint": "biome ci .",
    "fix": "biome check --write ."
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-ligatures": "0.10.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "dompurify": "3.4.17",
    "lowlight": "3.3.0",
    "mdast-util-from-markdown": "2.1.0",
    "mdast-util-frontmatter": "2.0.1",
    "mdast-util-gfm": "3.1.0",
    "mermaid": "12.3.0",
    "micromark-extension-frontmatter": "2.0.0",
    "micromark-extension-gfm": "3.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tauri-apps/cli": "2.12.4",
    "@testing-library/svelte": "5.4.2",
    "@types/node": "26.6.6",
    "jsdom": "30.1.3",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
