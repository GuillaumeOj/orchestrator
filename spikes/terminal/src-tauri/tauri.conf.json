{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OrchTerminalSpike",
  "version": "0.0.0",
  "identifier": "dev.orchestrator.terminal-spike",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Terminal spike",
        "width": 1200,
        "height": 800,
        "alwaysOnTop": true,
        "focus": false,
        "x": 2560,
        "y": 1300
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/icon.png"
    ]
  }
}